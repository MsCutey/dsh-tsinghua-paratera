{
  "name": "dsh-paratera-balance",
  "version": "0.3.0",
  "scripts": {
    "test": "node --test tests/client.test.mjs tests/host.test.mjs"
  },
  "private": true,
  "description": "DSH 原生模型栏余额插件：默认显示清华算力平台算力券余额（24 小时滑动会话，自动续期），可选回退并行智算云控制台金额",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "BCBAI",
  "repository": {
    "type": "git",
    "url": "https://git.tsinghua.edu.cn/bbc26/dsh-paratera-balance.git"
  },
  "homepage": "https://git.tsinghua.edu.cn/bbc26/dsh-paratera-balance",
  "bugs": {
    "url": "https://git.tsinghua.edu.cn/bbc26/dsh-paratera-balance/-/issues"
  },
  "keywords": [
    "balance",
    "deepseek-harness",
    "dsh-plugin",
    "easycompute",
    "tsinghua"
  ]
}
