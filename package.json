{
  "name": "dsh-paratera-balance",
  "version": "0.15.0",
  "scripts": {
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "install:dsh": "node scripts/install.mjs",
    "verify:dsh": "node scripts/install.mjs --verify",
    "verify:macos": "node scripts/verify-dsh-macos.mjs",
    "verify:chrome": "node scripts/verify-chrome-macos.mjs",
    "verify:host-sdk": "node scripts/verify-host-sdk.mjs",
    "task:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows-task.ps1",
    "task:macos": "node scripts/setup-macos-task.mjs",
    "build:macos": "node --input-type=module -e \"import {buildCredentialHelper} from './lib/macos-credentials.mjs'; console.log(await buildCredentialHelper())\""
  },
  "private": true,
  "description": "DSH 原生模型栏余额插件：读取清华算力平台算力券余额，专用浏览器会话自动续期，设置页可刷新与重新登录",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "BCBAI",
  "repository": {
    "type": "git",
    "url": "https://git.tsinghua.edu.cn/bbc26/dsh-paratera-balance.git"
  },
  "homepage": "https://git.tsinghua.edu.cn/bbc26/dsh-paratera-balance",
  "bugs": {
    "url": "https://git.tsinghua.edu.cn/bbc26/dsh-paratera-balance/-/issues"
  },
  "keywords": [
    "balance",
    "deepseek-harness",
    "dsh-plugin",
    "easycompute",
    "tsinghua"
  ]
}
